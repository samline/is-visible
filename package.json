{
  "name": "@samline/is-visible",
  "version": "1.1.2",
  "description": "Visibility callbacks for one or many elements on shared intersection observers, for vanilla JavaScript, React, Vue, Svelte and plain HTML.",
  "keywords": [
    "intersection-observer",
    "visibility",
    "in-view",
    "lazy",
    "react",
    "vue",
    "svelte"
  ],
  "author": "Samuel Olvera (samline)",
  "license": "MIT",
  "homepage": "https://samline.github.io/is-visible/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/is-visible.git"
  },
  "bugs": {
    "url": "https://github.com/samline/is-visible/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/browser/is-visible.global.js"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/is-visible.global.js",
  "jsdelivr": "./dist/browser/is-visible.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js",
      "require": "./dist/svelte/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./browser": "./dist/browser/is-visible.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run test:coverage && bun run build && bun run size && bun run test:e2e",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage",
    "release": "bun run check && pnpm publish",
    "site:dev": "node site-tools/assets.mjs && node site-tools/dev.mjs",
    "site:build": "node site-tools/assets.mjs && npm --workspace docs run build && npm --workspace landing run build && node site-tools/assemble.mjs && node site-tools/check-site.mjs",
    "site:preview": "node site-tools/preview.mjs",
    "site:check": "node site-tools/assets.mjs && node site-tools/check-config.mjs && npm run site:check:design && npm --workspace landing run check && npm --workspace docs run check",
    "site:format": "prettier --plugin prettier-plugin-astro --write landing docs/src docs/scripts shared site-tools site-tests site-e2e skills playwright.site.config.ts project.config.json content-audit.json design-reference.json SITE.md --ignore-path .site-prettierignore",
    "site:format:check": "prettier --plugin prettier-plugin-astro --check landing docs/src docs/scripts shared site-tools site-tests site-e2e skills playwright.site.config.ts project.config.json content-audit.json design-reference.json SITE.md --ignore-path .site-prettierignore",
    "site:test": "node --test site-tests/*.test.mjs",
    "site:test:browser": "playwright test --config playwright.site.config.ts",
    "site:verify": "npm run site:check && npm run site:format:check && npm run site:test && npm run site:test:adaptation && npm run site:build && npm run site:check:identity && npm run site:check:content && npm run site:test:browser",
    "site:configure": "node site-tools/configure.mjs",
    "site:check:release": "npm run site:check:identity && node site-tools/check-release.mjs",
    "site:check:content": "node site-tools/check-content.mjs",
    "site:accent": "node site-tools/accent-pair.mjs",
    "site:test:adaptation": "node site-tools/test-adaptation.mjs",
    "site:check:design": "node site-tools/check-design.mjs",
    "site:check:identity": "node site-tools/check-identity.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@samline/internal": "^1.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.1.0",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.0",
    "prettier-plugin-astro": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svelte": "^5.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.13"
  },
  "size": {
    "./dist/index.js": 1400,
    "./dist/browser/is-visible.global.js": 1400,
    "./dist/react/index.js": 2000,
    "./dist/vue/index.js": 2000,
    "./dist/svelte/index.js": 1800,
    "./dist/testing/index.js": 300
  },
  "workspaces": [
    "landing",
    "docs",
    "shared"
  ],
  "overrides": {
    "parse5": "^8.1.0",
    "@emnapi/runtime": "1.11.3"
  }
}
